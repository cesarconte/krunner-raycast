[Desktop Entry]
Name=Raycast Runner
Comment=Acciones rápidas del sistema, utilidades de desarrollo y búsquedas web estilo Raycast
X-KDE-ServiceTypes=Plasma/Runner
Type=Service
Icon=system-search
X-Plasma-API=DBus
X-KDE-PluginInfo-EnabledByDefault=true
X-KDE-PluginInfo-Name=Raycast
X-KDE-PluginInfo-Author=Cesar
X-KDE-PluginInfo-Version=1.0
X-KDE-PluginInfo-License=GPL-3.0-or-later
X-Plasma-DBusRunner-Service=org.cesar.KRunnerRaycast
X-Plasma-DBusRunner-Path=/KRunnerRaycast
X-Plasma-Request-Actions-Once=true
X-Plasma-Runner-Min-Letter-Count=1
X-Plasma-Runner-Syntaxes=:q:
X-Plasma-Runner-Syntax-Descriptions=Acciones Raycast: !gh, !yt, !g, bloquear, suspender, uuid, b64, hex, timestamp, kill...
